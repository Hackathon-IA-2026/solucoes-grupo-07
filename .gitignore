.DS_Store
.env
.venv/
.pytest_cache/
.ruff_cache/
.tmp/
__pycache__/
*.py[cod]

# Dados e artefatos de ML nao devem ir para o Git.
data/raw/*
data/interim/*
data/processed/*
models/*
!data/**/.gitkeep
!data/README.md
!models/.gitkeep

# Artefatos locais
.streamlit/secrets.toml
coverage.xml
htmlcov/
tmp/

# Etapa 2B: experiments/stage2b/experimentos é uma junção para o disco externo (não cabe
# no disco do repositório). Os arquivos leves das runs são versionados através dela; os
# pesados e os modelos ficam ignorados. Sem barra final, para casar também com links.
experiments/stage2b/experimentos/*/predictions
experiments/stage2b/experimentos/*/models
experiments/stage2b/experimentos/stage2b-datasets
experiments/stage2b/experimentos/**/*.parquet
experiments/stage2b/experimentos/**/*.joblib
experiments/stage2b/cache
experiments/stage2b/dados
experiments/stage2b/sondas
experiments/stage2b/env.ps1
experiments/stage2b/**/*.progress.jsonl
experiments/stage2b/**/*.sqlite
