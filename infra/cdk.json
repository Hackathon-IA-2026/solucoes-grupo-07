{
  "app": "uv run --extra infra python app.py",
  "output": "cdk.out",
  "watch": {
    "include": ["app.py", "curtamap_infra/**"]
  },
  "context": {
    "region": "us-east-1",
    "imageTag": "latest",
    "desiredCount": "1",
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": false,
    "@aws-cdk/core:defaultCrossStackReferences": "strong"
  }
}
